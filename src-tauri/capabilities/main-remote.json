{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-remote",
  "description": "IPC для веб-приложения Orbit. Разрешён только своему origin: ни встроенная страница-заглушка, ни чужие сайты в этом окне IPC не получают. Из прав — только то, что нужно PlatformAdapter: уведомления, автозапуск, сведения об ОС и версия приложения.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:5173", "https://orbit.invalid"]
  },
  "permissions": [
    "allow-report-spike",
    "allow-set-unread",
    "allow-set-push-to-talk",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-remove",
    "allow-secret-keys",
    "allow-secret-clear",
    "allow-secret-blob-put",
    "allow-secret-blob-get",
    "allow-secret-blob-remove",
    "core:app:allow-version",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "notification:default",
    "autostart:default"
  ]
}
